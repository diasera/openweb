# Supabase > Project Settings > Data API / API Keys
# Selama nilai contoh di bawah belum diganti, aplikasi berjalan di mode demo.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — HANYA dipakai di server (route handler / server action).
# Punya akses penuh ke database, JANGAN sampai terekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret untuk menandatangani cookie sesi owner/admin.
# Buat string acak minimal 32 karakter, mis. hasil: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Opsional: fallback origin sebelum URL utama disimpan lewat Profil Admin.
# Gunakan origin tanpa path, misalnya https://komunitas.example
# NEXT_PUBLIC_SITE_URL=https://komunitas.example

# Opsional untuk self-hosted. Jangan isi kecuali origin hanya menerima trafik
# proxy tersebut dan proxy selalu menimpa header IP dari klien.
# Pilihan: cloudflare | x-real-ip | x-forwarded-for (Vercel terdeteksi otomatis)
# TRUSTED_PROXY=cloudflare

# Opsional: zona waktu IANA untuk agenda & "Kenangan hari ini" (bawaan Asia/Jakarta).
# Dipakai server dan browser; ubah lalu build ulang. Contoh: Asia/Makassar, Asia/Jayapura
# NEXT_PUBLIC_SITE_TIME_ZONE=Asia/Jakarta

# Opsional: Web Push (VAPID) agar notifikasi admin terkirim ke perangkat
# pengunjung. Generate sepasang kunci: npx web-push generate-vapid-keys
# Tanpa kunci ini, lonceng tetap jalan sebagai daftar notifikasi in-app.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
