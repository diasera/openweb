{
  "name": "openweb",
  "version": "1.2.0",
  "private": true,
  "description": "Template website komunitas yang dapat dikustomisasi dari panel admin, dengan UI terinspirasi iOS dan Pinterest.",
  "license": "MIT",
  "author": "diasera (https://github.com/diasera)",
  "homepage": "https://github.com/diasera/openweb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diasera/openweb.git"
  },
  "bugs": {
    "url": "https://github.com/diasera/openweb/issues"
  },
  "keywords": [
    "nextjs",
    "react",
    "supabase",
    "tailwindcss",
    "typescript",
    "pwa",
    "community",
    "komunitas",
    "website-template",
    "cms"
  ],
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.12 <27",
    "npm": ">=10.9 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:member-slugs": "node scripts/check-member-slugs.mjs",
    "check:media-formats": "node scripts/check-media-formats.mjs",
    "check:share-target": "node scripts/check-share-target.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "clsx": "^2.1.1",
    "heic-to": "^1.6.7",
    "jose": "^6.2.17",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "^4.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.29"
    }
  }
}
